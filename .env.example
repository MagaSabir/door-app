# Публичный адрес сайта: canonical, sitemap, OG-картинки. На Vercel без него берётся продакшен-домен проекта
NEXT_PUBLIC_SITE_URL=https://example.ru

# Коды подтверждения прав на сайт (только значение content из meta-тега)
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# Куда отправлять заявки с форм (замер, обратный звонок). Без этих переменных они пишутся только в лог сервера.
# Токен бота — у @BotFather, chat_id — id чата/группы менеджеров.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
